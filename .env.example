# ============================================================
# MediTwin AI — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# LLM Provider — set to: openai | anthropic | groq | ollama
LLM_PROVIDER=groq

# API Keys (only fill the one you are using)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# Model names per provider
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307
GROQ_MODEL=llama-3.1-70b-versatile

# Ollama (local) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Kaggle credentials (for dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Paths
DATA_DIR=./data
MODELS_DIR=./models
OUTPUTS_DIR=./outputs
RAG_CORPUS_DIR=./rag_corpus
CHROMA_PERSIST_DIR=./outputs/chromadb
